---
import '@fontsource-variable/nunito'; // Theme B's rounded font, served from this site (Peter, Nov 14 2026)
import '../styles/global.css';
import { LANGS } from '../i18n/strings';
// The picker's order: English, then Vietnamese, Afrikaans, Spanish, French, Portuguese and Dutch at the top (the owners' ask), the rest as listed.
const LANG_MENU_TOP = ['en', 'vi', 'af', 'es', 'fr', 'pt', 'nl'];
const LANG_MENU_ORDER: string[] = [...LANG_MENU_TOP, ...LANGS.map((l) => l.code).filter((c) => !LANG_MENU_TOP.includes(c))];
import { store } from '../data/store';
interface Props { title: string; description?: string }
const { title, description = `Shipping, packing, mailboxes and printing at ${store.address}.` } = Astro.props;
// The brand reads "Goin' Postal" plus the store's own word: Forsythe, Oak Grove.
// Beside the logo: the store's header label (the address, for Forsythe; Peter Nov 15 2026), else the last part of its name.
const brandRest = store.headerLabel || store.name.replace(/^Goin' Postal\s*/i, '') || store.name;
// The nav tab for the page being viewed is drawn pressed (aria-current).
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const cur = (p: string) => (here === p || (p !== '/' && here.startsWith(p + '/')) ? 'page' : undefined);
import CarrierBadges from '../components/CarrierBadges.astro';
import { PRINT_CATALOG, ALL_PRINTING, sectionFrom } from '../data/printCatalog';
import PrintArt from '../components/PrintArt.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip" href="#main" data-i18n="a11y.skip">Skip to content</a>
    <!-- Theme B (Peter, Nov 14 2026): language, text size and contrast sit in a slim bar above the header, like ups.com. -->
    <div class="utility">
      <div class="wrap utility-in">
          {Astro.url.pathname.startsWith('/counter') && store.siblings && store.siblings.length > 0 && (
          <select id="storeSwitch" aria-label="Store" title="Store">
            <option value="">{store.name}</option>
            {store.siblings.map((s) => <option value={s.url}>{s.name}</option>)}
          </select>
        )}
        <label class="lang-label" for="lang"><span lang="en">Language</span> / <span lang="vi">Ngôn ngữ</span></label>
        <select id="lang" aria-label="Language / Ngôn ngữ" title="Language / Ngôn ngữ">
          {[...LANGS].sort((a, b) => LANG_MENU_ORDER.indexOf(a.code) - LANG_MENU_ORDER.indexOf(b.code)).map((l) => <option value={l.code}>{l.name}</option>)}
        </select>
        <span class="a11y" role="group" aria-label="Text size">
          <span class="a11y-label" data-i18n="a11y.text">Text size</span>
          <button type="button" class="size" data-size="0" aria-label="Smaller text">A&minus;</button>
          <button type="button" class="size" data-size="1" aria-label="Normal text">A</button>
          <button type="button" class="size" data-size="2" aria-label="Larger text">A+</button>
          <button type="button" class="size" data-size="3" aria-label="Even larger text">A++</button>
          <button type="button" class="size" data-size="4" aria-label="Largest text">A+++</button>
          <button type="button" class="size contrast" id="contrast" aria-pressed="false"><span data-i18n="a11y.contrast">High contrast</span></button>
        </span>
      </div>
    </div>
    <header class="top">
      <div class="wrap">
        <div class="top-row">
          <!-- The franchise's own logo file, used as supplied: never redrawn or recolored. -->
          <a class="brand" href="/"><img src="/brand/goin-postal-logo.png" alt="Goin' Postal" width="170" height="35" /><span class="brand-store">{brandRest}</span></a>
          <!-- The carriers the store ships with (Peter, Nov 15 2026), in the space between the logo and Log in. Wide screens only. -->
          <div class="hdr-carriers"><span class="muted" data-i18n="carr.weship">Authorized for</span><CarrierBadges /></div>
          <!-- Log in, top right of every page (Peter, Nov 14 2026). Signed in, it greets the customer and opens their account. -->
          <!-- Signed in, the button says "Hi, Peter" and opens the account menu (Peter, Nov 25 2026: "account could be ... where
               it saids 'Hi, Peter' possibly a dropdown menu"); signed out, it's Log in. -->
          <div class="acct-drop" id="acctDrop">
            <a class="login-btn" id="loginBtn" href="/account" data-i18n="acct.login">Log in</a>
            <div class="acct-menu" id="acctMenu">
              <a href="/account" data-i18n="acct.m.account">My account</a>
              <a href="/account#orders" data-i18n="acct.m.orders">My orders & shipments</a>
              <a href="/account#mailbox" data-i18n="acct.m.mailbox">My mailbox</a>
              <button type="button" id="acctOut" data-i18n="acct.logout">Sign out</button>
            </div>
          </div>
        </div>
        <nav aria-label="Main">
          <a href="/ship" class="ps-tab" aria-current={cur('/ship')} data-i18n="home.cta">Ship a package</a>
          <!-- Tracking menu (Peter, Nov 14 2026, like ups.com): opens on hover or keyboard focus; the arrow opens it on a phone. -->
          <div class="nav-drop" id="trackDrop">
            <a href="/track" aria-current={cur('/track')} data-i18n="nav.track">Tracking</a>
            <button type="button" class="nav-caret" aria-expanded="false" aria-controls="trackMenu" aria-label="Tracking menu">▾</button>
            <div class="nav-menu" id="trackMenu">
              <a href="/track" data-i18n="nav.trackone">Track a shipment</a>
              <a href="/account#orders" data-i18n="nav.allships">View all shipments</a>
            </div>
          </div>
          <!-- Printing is the catalog bar below (Nov 25 2026); Hours and Contact are one link; Account is the "Hi" button;
               About PeterShip is in the footer. -->
          <a href="/mailbox" aria-current={cur('/mailbox')} data-i18n="nav.mailboxes">Mailboxes</a>
          <a href="/#services" data-i18n="nav.services">Services</a>
          <a href="/contact" aria-current={cur('/contact')} data-i18n="nav.contacthours">Contact & Hours</a>
        </nav>
      </div>
      <!-- The print catalog bar (Peter, Nov 25 2026: "i like how vistaprint or 4over has their catalog all over the top"):
           every printing category on every page, each with a big dropdown (src/data/printCatalog.ts). On a phone it is one
           row that swipes sideways and each opens its shop page; the dropdowns open on hover or keyboard focus on wide screens. -->
      <div class="catbar">
        <div class="wrap catbar-row" role="navigation" aria-label="Print shop">
          {PRINT_CATALOG.map((g) => (
            <div class="cat-drop">
              <a href={g.href} class="cat-link" aria-current={cur(g.href) ?? undefined} data-i18n={g.key}>{g.label}</a>
              <!-- The big dropdown (Peter, Nov 25 2026: "lets add a drop down menu like how this works", like Gelato's):
                   ways to order, the category's sections, and a picture with the starting price. -->
              <div class="cat-mega">
                <div class="wrap cat-mega-in">
                  <div class="mm-ways">
                    {(() => { const first = g.sections.find((s) => s.products.length || s.link); return first ? <a class="mm-quick" href={first.link ? first.link.href : `/print?product=${first.products[0]}`}><strong data-i18n="mm.design">Design it online</strong><span data-i18n="mm.design.p">Pick, preview and pay</span></a> : <a class="mm-quick" href="/contact"><strong data-i18n="cat.ask">Ask for a price</strong><span data-i18n="mm.ask.p">We'll send a price and a proof</span></a>; })()}
                    {g.bulk && <a class="mm-quick" href="/printing/t-shirts"><strong data-i18n="mm.bulk">12 or more?</strong><span data-i18n="mm.bulk.p">Team, church & business orders</span></a>}
                    <a class="mm-quick" href="/contact"><strong data-i18n="mm.rush">Need it fast?</strong><span data-i18n="mm.rush.p">Ask us about rush</span></a>
                  </div>
                  <div class="mm-col">
                    <p class="mm-h" data-i18n="mm.shopby">Shop by product</p>
                    {g.sections.map((s) => <a href={`${g.href}/${s.id}`} data-i18n={s.key}>{s.label}</a>)}
                    <a class="mm-all" href={g.href}><span data-i18n="mm.viewall">View all</span> <span data-i18n={g.key}>{g.label}</span></a>
                  </div>
                  <a class={`mm-feature pcat-${g.art}`} href={g.href}>
                    <span class="mm-feature-pic"><PrintArt art={g.art} /></span>
                    <span class="mm-feature-text"><strong data-i18n={g.key}>{g.label}</strong>{g.from != null ? <span><span data-i18n="cat.from">From</span> ${g.from.toFixed(2)}</span> : <span data-i18n="cat.ask">Ask for a price</span>}</span>
                  </a>
                </div>
              </div>
            </div>
          ))}
          <div class="cat-drop"><a href={ALL_PRINTING.href} class="cat-link cat-all" aria-current={cur('/printing') ?? undefined} data-i18n={ALL_PRINTING.key}>{ALL_PRINTING.label}</a></div>
        </div>
      </div>
    </header>
    <main class="wrap" id="main">
      <slot />
    </main>
    <footer>
      <div class="wrap">
        <div class="foot-carriers"><span data-i18n="carr.footer">Authorized shipping location for</span><CarrierBadges /></div>
        {store.name} · {store.address}.
        <span data-i18n="footer">Goin' Postal's name and logo belong to GP Brands. Independently owned and operated.</span>
        · <a href="/petership" data-i18n="nav.about">About PeterShip</a>
        · <a href="/counter" data-i18n="st.in.link">Staff sign-in</a>
      </div>
    </footer>
    <script>
      import { apply, setLang, t, tf, type Lang } from '../i18n';
      (window as any).t = t; (window as any).tf = tf; // for the inline scripts on the order pages
      apply();
      // Staff pages keep working when the shop's internet drops: see public/counter-sw.js.
      if (location.pathname.startsWith('/counter/') && 'serviceWorker' in navigator) navigator.serviceWorker.register('/counter-sw.js', { scope: '/counter/' }).catch(() => {});
      // Staff pages keep working when the shop's internet drops: see public/counter-sw.js.
      if (location.pathname.startsWith('/counter/') && 'serviceWorker' in navigator) navigator.serviceWorker.register('/counter-sw.js', { scope: '/counter/' }).catch(() => {});
      // Text size and contrast, remembered on this device.
      const root = document.documentElement;
      const get = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
      const set = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };
      function size(n: string) { root.dataset.size = n; set('gp-size', n); document.querySelectorAll<HTMLElement>('.size[data-size]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.size === n))); }
      function contrast(on: boolean) { root.dataset.contrast = on ? 'high' : ''; set('gp-contrast', on ? '1' : '0'); document.getElementById('contrast')!.setAttribute('aria-pressed', String(on)); }
      size(get('gp-size') ?? '2');
      contrast(get('gp-contrast') === '1'); // off unless the visitor turned it on (v1.70.0: the glossy look is the default; High contrast is one click away)
      document.querySelectorAll<HTMLElement>('.size[data-size]').forEach((b) => b.addEventListener('click', () => size(b.dataset.size!)));
      document.getElementById('contrast')!.addEventListener('click', () => contrast(root.dataset.contrast !== 'high'));
      // Log in button: ask who is signed in. Signed out, the link comes back to this page after signing in.
      const loginBtn = document.getElementById('loginBtn') as HTMLAnchorElement | null;
      let me: { signed_in: boolean; name?: string } | null = null;
      const paintLogin = () => {
        if (!loginBtn) return;
        if (me?.signed_in) { delete loginBtn.dataset.i18n; loginBtn.textContent = me.name ? t('acct.hi').replace('{name}', me.name) : t('nav.account'); loginBtn.href = '/account'; loginBtn.classList.add('in'); document.getElementById('acctDrop')?.classList.add('in'); loginBtn.setAttribute('aria-haspopup', 'true'); }
        else if (!location.pathname.startsWith('/account')) loginBtn.href = `/account?next=${encodeURIComponent(location.pathname + location.search)}`;
      };
      if (loginBtn && !location.pathname.startsWith('/counter')) fetch('/api/account', { credentials: 'same-origin' }).then((r) => r.json()).then((j) => { me = j; paintLogin(); }).catch(() => {});
      paintLogin(); document.addEventListener('langchange', paintLogin);
      // The catalog bar's big dropdowns (Peter, Nov 25 2026: "it disappears when i try to click one of the options").
      // A panel opens when the mouse rests on its category, stays open for a moment after the mouse leaves (so the way
      // down to an option never closes it), and another category takes over only if the mouse stops on it.
      (() => {
        const drops = [...document.querySelectorAll<HTMLElement>('.catbar .cat-drop')].filter((d) => d.querySelector('.cat-mega'));
        let openDrop: HTMLElement | null = null; let closeT = 0; let switchT = 0;
        const show = (d: HTMLElement | null) => { if (openDrop && openDrop !== d) openDrop.classList.remove('open'); openDrop = d; d?.classList.add('open'); };
        for (const d of drops) {
          d.addEventListener('mouseenter', () => {
            clearTimeout(closeT); clearTimeout(switchT);
            if (!openDrop) switchT = window.setTimeout(() => show(d), 80);      // first open: a tiny pause so passing over doesn't flash
            else if (openDrop !== d) switchT = window.setTimeout(() => show(d), 220); // another one is open: switch only if the mouse stays
          });
          d.addEventListener('mouseleave', () => { clearTimeout(switchT); closeT = window.setTimeout(() => show(null), 350); });
        }
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') show(null); });
      })();
      // The account menu: hover or keyboard focus opens it on a computer; a tap on "Hi, Peter" opens it on a phone.
      const acctDrop = document.getElementById('acctDrop');
      loginBtn?.addEventListener('click', (e) => { if (!me?.signed_in) return; e.preventDefault(); acctDrop?.classList.toggle('open'); loginBtn.setAttribute('aria-expanded', String(acctDrop?.classList.contains('open'))); });
      document.addEventListener('click', (e) => { if (acctDrop && !acctDrop.contains(e.target as Node)) acctDrop.classList.remove('open'); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') acctDrop?.classList.remove('open'); });
      document.getElementById('acctOut')?.addEventListener('click', async () => {
        await fetch('/api/account', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'logout' }) }).catch(() => {});
        location.href = '/';
      });
      // Tracking and Printing menus: the arrow button opens and closes one (hover and keyboard focus open it through CSS);
      // opening one closes the other; Escape or a click elsewhere closes it.
      const drops = [['trackDrop', 'nav.trackmenu'], ['printDrop', 'nav.printmenu']].filter(([id]) => document.getElementById(id)).map(([id, label]) => {
        const drop = document.getElementById(id)!, caret = drop.querySelector<HTMLButtonElement>('.nav-caret')!;
        return { drop, caret, label };
      });
      const openDrop = (d: (typeof drops)[number], on: boolean) => {
        if (on) d.drop.style.setProperty('--menu-top', `${Math.round((d.drop.closest('nav') ?? d.caret).getBoundingClientRect().bottom + 4)}px`); // phones: the panel sits under the bar
        d.drop.classList.toggle('open', on); d.caret.setAttribute('aria-expanded', String(on));
      };
      // Phones: scrolling the page closes an open panel, so it never floats away from the bar.
      window.addEventListener('scroll', () => drops.forEach((o) => { if (o.drop.classList.contains('open')) openDrop(o, false); }), { passive: true });
      for (const d of drops) {
        d.caret.addEventListener('click', (e) => { e.stopPropagation(); const on = !d.drop.classList.contains('open'); drops.forEach((o) => openDrop(o, false)); openDrop(d, on); });
        d.drop.addEventListener('keydown', (e) => { if (e.key === 'Escape') { openDrop(d, false); d.caret.focus(); } });
      }
      document.addEventListener('click', (e) => { for (const d of drops) if (!d.drop.contains(e.target as Node)) openDrop(d, false); });
      const caretLabel = () => drops.forEach((d) => d.caret.setAttribute('aria-label', t(d.label)));
      caretLabel(); document.addEventListener('langchange', caretLabel);
      document.getElementById('lang')!.addEventListener('change', (e) => { const el = e.target as HTMLSelectElement; setLang(el.value as Lang); el.blur(); });
    </script>
      <script>
      // Store switcher (T23): the same counter page on the other store's deployment.
      const sw = document.getElementById('storeSwitch') as HTMLSelectElement | null;
      sw?.addEventListener('change', () => { if (sw.value) location.href = sw.value.replace(/\/$/, '') + location.pathname; });
    </script>
  </body>
</html>
