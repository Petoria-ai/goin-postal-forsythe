---
// The print shop's picture cards (Peter, Nov 25 2026: "gelato has pictures of the types of things they sell"): one card
// per category from src/data/printCatalog.ts, with a light drawing of the product until real photos arrive (Gelato's
// Mockup Studio or photos of samples: put the file in public/print/<id>.jpg and set `photo` below), the category's
// name and its starting price, or "Ask for a price" when it is quoted in the store.
import { PRINT_CATALOG } from '../data/printCatalog';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const photo: Record<string, string> = {}; // e.g. { womens: '/print/womens.jpg' }
const money = (n: number) => `$${n.toFixed(2)}`;
---
<div class={`pcat-grid${compact ? ' compact' : ''}`}>
  {PRINT_CATALOG.map((c) => (
    <a class="pcat-card" href={c.href}>
      <div class={`pcat-pic pcat-${c.art}`}>
        {photo[c.id] ? <img src={photo[c.id]} alt="" loading="lazy" /> : (
          <svg viewBox="0 0 200 150" role="img" aria-hidden="true">
            {c.art === 'womens' && <g><path d="M70 28 L52 40 L40 66 L58 74 L64 62 L66 122 Q100 130 134 122 L136 62 L142 74 L160 66 L148 40 L130 28 Q100 46 70 28 Z" fill="#e9785a" /><path d="M82 30 Q100 42 118 30" stroke="#c95d42" stroke-width="3" fill="none" /><circle cx="100" cy="82" r="12" fill="#ffd27a" /></g>}
            {c.art === 'mens' && <g><path d="M68 30 L46 42 L32 76 L52 84 L60 66 L60 124 L140 124 L140 66 L148 84 L168 76 L154 42 L132 30 Q100 50 68 30 Z" fill="#9aa3ad" /><path d="M76 30 Q100 16 124 30 Q114 52 100 52 Q86 52 76 30 Z" fill="#7d8690" /><rect x="76" y="84" width="48" height="22" rx="6" fill="#7d8690" /><path d="M88 66 l12 10 l12 -10" stroke="#f0c75e" stroke-width="5" fill="none" stroke-linecap="round" /></g>}
            {c.art === 'kids' && <g><path d="M76 36 L58 46 L50 64 L66 70 L72 60 L72 104 Q74 120 90 122 L94 110 L106 110 L110 122 Q126 120 128 104 L128 60 L134 70 L150 64 L142 46 L124 36 Q100 50 76 36 Z" fill="#9fd0ea" /><circle cx="100" cy="78" r="9" fill="#fff" /><circle cx="96" cy="76" r="1.8" fill="#335" /><circle cx="104" cy="76" r="1.8" fill="#335" /></g>}
            {c.art === 'hats' && <g><path d="M52 92 Q52 44 100 42 Q148 44 148 92 Z" fill="#26346b" /><path d="M48 92 L170 92 Q178 104 160 106 L50 104 Q42 100 48 92 Z" fill="#1b2650" /><circle cx="100" cy="44" r="5" fill="#1b2650" /><path d="M86 70 l14 -12 l14 12" stroke="#f0c75e" stroke-width="5" fill="none" stroke-linecap="round" /></g>}
            {c.art === 'drinkware' && <g><rect x="58" y="44" width="62" height="74" rx="8" fill="#5bb5a7" /><path d="M120 60 Q146 60 146 80 Q146 100 120 100" stroke="#5bb5a7" stroke-width="10" fill="none" /><rect x="132" y="30" width="22" height="88" rx="9" fill="#f2f2f2" stroke="#d7d7d7" stroke-width="2" /><rect x="136" y="22" width="14" height="10" rx="3" fill="#9aa3ad" /><circle cx="89" cy="80" r="13" fill="#f6d36a" /></g>}
            {c.art === 'wallart' && <g><rect x="40" y="26" width="72" height="96" rx="3" fill="#2a2a2a" /><rect x="46" y="32" width="60" height="84" fill="#f5b86a" /><circle cx="76" cy="64" r="16" fill="#e9785a" /><path d="M46 116 L72 86 L88 100 L106 80 L106 116 Z" fill="#5b8fd0" /><rect x="120" y="46" width="48" height="64" rx="3" fill="#2a2a2a" /><rect x="125" y="51" width="38" height="54" fill="#c6e3d8" /><path d="M125 105 L140 84 L163 105 Z" fill="#5bb5a7" /></g>}
            {c.art === 'signs' && <g><rect x="34" y="34" width="132" height="54" rx="4" fill="#d0312d" /><circle cx="40" cy="40" r="3" fill="#fff" /><circle cx="160" cy="40" r="3" fill="#fff" /><rect x="56" y="52" width="88" height="8" rx="4" fill="#fff" /><rect x="70" y="66" width="60" height="6" rx="3" fill="#ffd27a" /><rect x="70" y="96" width="60" height="34" rx="3" fill="#26346b" /><rect x="80" y="130" width="4" height="12" fill="#888" /><rect x="116" y="130" width="4" height="12" fill="#888" /><rect x="80" y="106" width="40" height="6" rx="3" fill="#fff" /></g>}
            {c.art === 'stationery' && <g><rect x="40" y="30" width="70" height="94" rx="3" fill="#fff" stroke="#ddd" stroke-width="2" /><rect x="48" y="40" width="54" height="26" fill="#5b8fd0" /><rect x="48" y="74" width="54" height="5" rx="2" fill="#ccc" /><rect x="48" y="84" width="40" height="5" rx="2" fill="#ccc" /><rect x="96" y="70" width="80" height="46" rx="4" fill="#26346b" transform="rotate(-8 136 93)" /><rect x="90" y="80" width="80" height="46" rx="4" fill="#fff" stroke="#ddd" stroke-width="2" /><circle cx="106" cy="103" r="8" fill="#d0312d" /><rect x="120" y="96" width="40" height="5" rx="2" fill="#26346b" /><rect x="120" y="106" width="28" height="4" rx="2" fill="#aaa" /></g>}
          </svg>
        )}
      </div>
      <div class="pcat-body">
        <p class="pcat-kicker" data-i18n="cat.kicker">Category</p>
        <h3 class="pcat-name" data-i18n={c.key}>{c.label}</h3>
        {c.from != null
          ? <p class="pcat-price"><span data-i18n="cat.from">From</span> {money(c.from)}</p>
          : <p class="pcat-price ask" data-i18n="cat.ask">Ask for a price</p>}
      </div>
    </a>
  ))}
</div>
