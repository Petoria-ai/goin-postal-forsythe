---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import MailboxDocs from '../../components/MailboxDocs.astro';

// Staff page: virtual mailboxes on Anytime Mailbox (Peter, Nov 19 2026). Separate from the wall boxes (William's rule:
// a virtual number is never a wall box number). Anytime Mailbox stays the record of these customers (their billing and
// scans); this list lets staff recognize the mail (Mail check on the Mailboxes page searches it too) and keep the
// customer's documents and allowed names. The Anytime Mailbox API and logo come later (to-do P18).
---
<Base title="Counter · Virtual mail">
  <section class="hero">
    <h1 data-i18n="st.vm.h1">Virtual mail</h1>
    <p class="staff-nav"><span data-i18n="st.staff">Staff:</span> <a href="/counter/queue" data-i18n="st.nav.queue">Queue</a> · <a href="/counter/batch" data-i18n="st.nav.batch">Batch</a> · <a href="/counter/fulfillment" data-i18n="st.nav.fulfillment">Fulfillment</a> · <a href="/counter/pickups" data-i18n="st.nav.pickups">Pickups</a> · <a href="/counter/customers" data-i18n="st.nav.customers">Customers</a> · <a href="/counter/accounts" data-i18n="st.nav.accounts">Accounts</a> · <a href="/counter/dropoff" data-i18n="st.nav.dropoffs">Drop-offs</a> · <a href="/counter/scan" data-i18n="st.nav.scan">Scan a QR</a> · <a href="/counter/exceptions" data-i18n="st.nav.exceptions">Exceptions</a> · <a href="/counter/claims" data-i18n="st.nav.claims">Claims</a> · <a href="/counter/reports" data-i18n="st.nav.reports">Reports</a> · <a href="/counter/close" data-i18n="st.nav.close">End of day</a> · <a href="/counter/invoices" data-i18n="st.nav.invoices">Invoices</a> · <a href="/counter/rules" data-i18n="st.nav.prices">Prices</a> · <a href="/counter/staff" data-i18n="st.nav.staff">Staff</a> · <a href="/counter/settings" data-i18n="st.nav.settings">Settings</a> · <a href="/counter/mailboxes" data-i18n="st.nav.mailboxes">Mailboxes</a> · <a href="/counter/virtual" data-i18n="st.nav.virtual">Virtual mail</a> · <a href="/counter/export" data-i18n="st.nav.export">Export</a></p>
    <p class="lead" data-i18n="st.vm.lead">Customers whose mail service runs on a virtual mailbox service, one tab each. Their mail is scanned in that service's app, never put in a wall box. Mail check on the Mailboxes page finds them too.</p>
  </section>

  <div class="card">
    <p class="btnrow">
      <label><span data-i18n="st.pin">Staff PIN</span> <input id="pin" type="password" inputmode="numeric" autocomplete="off" /></label>
      <button class="btn" id="load" data-i18n="st.show">Show</button>
    </p>
    <p id="msg" role="alert"></p>
  </div>

  <div id="vmMain" class="hidden">
    <nav class="vm-tabs" role="tablist" id="vmTabs" aria-label="Virtual mailbox services"></nav>
    <div class="card">
      <h3 data-i18n="st.vm.list.h">Virtual mailboxes</h3>
      <p class="btnrow"><button type="button" class="btn small kraft" id="vmSyncBtn" hidden></button> <span id="vmSyncSum" class="muted"></span>
        <button type="button" class="linkish" id="vmSyncHide" hidden data-i18n="st.vm.sync.hide">Hide</button></p>
      <!-- Sync results (Peter, Nov 19 2026: "it seems to blow up my whole page"): grouped, folded, in a box that scrolls. -->
      <div id="vmSync" class="vm-sync"></div>
      <p id="vmNoId" class="vm-noid-banner" hidden><span></span> <button type="button" class="linkish" id="vmNoIdBtn"></button></p>
      <p><input id="vmSearch" type="search" data-i18n-ph="st.ci.search" placeholder="Box # or name" /></p>
      <!-- Its own scrolling box (Peter, Nov 23 2026: 80 customers "flooded my whole page"). -->
      <ul id="vmList" class="mb-check-out vm-list"></ul>
    </div>

    <!-- Folded near the bottom (Peter, Nov 19 2026): Sync brings customers in; adding by hand is the exception. -->
    <details class="card vm-addbox" id="vmAddBox">
      <summary><h3 data-i18n="st.vm.addhand">Add someone by hand</h3></summary>
      <form id="vmForm" class="vm-form" autocomplete="off">
        <input type="hidden" name="id" />
        <label><span id="vmVnoLabel" data-i18n="st.vm.vno">Anytime Mailbox #</span> <input name="vno" required maxlength="20" /></label>
        <label><span data-i18n="st.c.th.name">Name</span> <input name="name" required maxlength="80" /></label>
        <label><span data-i18n="st.vm.email">Email</span> <input name="email" type="email" maxlength="120" /></label>
        <label><span data-i18n="st.vm.phone">Phone</span> <input name="phone" inputmode="tel" maxlength="30" /></label>
        <label class="vm-wide"><span data-i18n="st.vm.names">Other names allowed (family, business), one per line</span> <textarea name="names" rows="2"></textarea></label>
        <label class="vm-wide"><span data-i18n="st.vm.note">Note</span> <input name="note" maxlength="300" /></label>
        <div class="vm-wide vm-link">
          <span data-i18n="st.vm.account">Website account (optional, for Documents)</span>
          <span id="vmAccount" class="muted" data-i18n="st.vm.noacct">None linked</span>
          <input id="vmFindQ" data-i18n-ph="st.mb.find.ph" placeholder="Name, email or phone" /> <button type="button" class="btn small kraft" id="vmFind" data-i18n="st.mb.find">Find</button>
          <button type="button" class="linkish" id="vmUnlink" hidden data-i18n="st.vm.unlink">Unlink</button>
          <ul id="vmFound" class="mb-found"></ul>
          <input type="hidden" name="customer_id" />
        </div>
        <p class="btnrow vm-wide"><button type="submit" class="btn" id="vmSave" data-i18n="st.vm.save">Add</button> <button type="button" class="btn kraft" id="vmCancel" hidden data-i18n="st.vm.cancel">Cancel editing</button></p>
      </form>
      <!-- Danger zone (Peter, Nov 23 2026): only while editing someone, only for a manager or owner PIN. -->
      <div id="vmCheckBox" class="vm-check" hidden>
        <button type="button" class="btn small kraft" id="vmCheck"></button>
        <pre id="vmCheckOut" class="vm-check-out" hidden></pre>
      </div>
      <div id="vmDanger" class="vm-danger" hidden>
        <h4 data-i18n="st.vm.danger.h">Danger zone</h4>
        <p class="muted small" id="vmDangerLead"></p>
        <p class="btnrow">
          <button type="button" class="btn small kraft" id="vmCloseOnly" data-i18n="st.vm.danger.closeonly">Close on our list only</button>
          <button type="button" class="btn small vm-danger-btn" id="vmDeact"></button>
          <button type="button" class="btn small vm-danger-btn" id="vmDel"></button>
        </p>
      </div>
      <dialog id="vmDangerDlg" class="vm-danger-dlg">
        <form method="dialog" id="vmDangerForm">
          <h3 id="vmDangerTitle"></h3>
          <p id="vmDangerText"></p>
          <label><span id="vmDangerTypeLabel"></span> <input name="confirm" autocomplete="off" spellcheck="false" /></label>
          <p class="btnrow"><button type="button" class="btn vm-danger-btn" id="vmDangerGo" disabled data-i18n="st.vm.danger.go">Yes, do it</button>
            <button type="submit" class="btn kraft" data-i18n="st.vm.danger.cancel">Cancel</button></p>
        </form>
      </dialog>
    </details>

    <!-- At the bottom (Peter, Nov 19 2026): set once, rarely touched. -->
    <div class="card vm-connect" id="vmConnect">
      <h3><span class="vm-badge" id="vmProvBadge"></span> <span data-i18n="st.vm.conn.h">Connection</span></h3>
      <p id="vmConnText" class="muted"></p>
      <p id="vmKeyInfo" class="vm-keyinfo"></p>
      <form id="vmKeyForm" class="vm-keyform" autocomplete="off" hidden>
        <label><span data-i18n="st.vm.key.label">Operator API key</span>
          <input type="password" name="key" autocomplete="new-password" spellcheck="false" maxlength="500" /></label>
        <button type="submit" class="btn small" data-i18n="st.vm.key.save">Save key</button>
        <button type="button" class="btn small kraft" id="vmKeyTest" data-i18n="st.vm.key.test">Test</button>
        <button type="button" class="btn small" id="vmKeyRemove" data-i18n="st.vm.key.remove">Remove key</button>
        <p class="muted small" data-i18n="st.vm.key.owner">Owner PIN only. The key is locked before it's saved and is never shown again, only its last four characters. Never paste it in chat or email.</p>
      </form>
    </div>
  </div>

  <MailboxDocs />

  <script>
    import { t, tf } from '../../i18n';
    const $ = (id: string) => document.getElementById(id)!;
    const pin = () => ($('pin') as HTMLInputElement).value;
    const msg = $('msg');
    const say = (text: string, err = false) => { msg.className = err ? 'err' : 'ok-msg'; msg.textContent = text; };
    async function api(path: string, extra: Record<string, unknown>) {
      const res = await fetch(path, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pin: pin(), ...extra }) });
      const j = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(j.error ?? 'Try again');
      return j;
    }
    const btn = (label: string, cls: string, fn: () => void) => { const b = document.createElement('button'); b.type = 'button'; b.className = `btn small ${cls}`; b.textContent = label; b.addEventListener('click', fn); return b; };
    const form = $('vmForm') as HTMLFormElement;
    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    let rows: any[] = [];
    // One tab per service (src/data/virtual.json); the page remembers the tab in the address (#anytime).
    let providers: any[] = [];
    let canKeys = false;
    let role = 'counter';
    let onlyNoId = false; // "Show only them": customers with no ID date yet
    let current = location.hash.slice(1) || 'anytime';
    const prov = () => providers.find((p) => p.id === current) ?? providers[0];
    function paintTabs() {
      const nav = $('vmTabs'); nav.innerHTML = '';
      for (const p of providers) {
        const b = document.createElement('button'); b.type = 'button'; b.setAttribute('role', 'tab');
        b.className = `vm-tab${p.id === prov().id ? ' on' : ''}`; b.setAttribute('aria-selected', String(p.id === prov().id));
        const n = rows.filter((v) => v.provider === p.id && v.status === 'active').length;
        b.textContent = `${p.name}${n ? ` (${n})` : ''}`;
        b.addEventListener('click', () => { current = p.id; history.replaceState(null, '', `#${p.id}`); resetForm(); paintAll(); });
        nav.appendChild(b);
      }
    }
    function paintProvider() {
      const p = prov();
      $('vmProvBadge').textContent = p.name;
      $('vmConnText').textContent = p.connected ? tf('st.vm.conn.on', { provider: p.name }) : tf('st.vm.conn.off', { provider: p.name });
      $('vmConnect').classList.toggle('on', !!p.connected);
      // The key: who set it and its last four characters, never the key (lib/serviceKeys.ts).
      const k = p.key ?? {};
      $('vmKeyInfo').textContent = k.source === 'server' ? tf('st.vm.key.server', { last4: k.last4 })
        : k.source === 'site' ? `${tf('st.vm.key.on', { last4: k.last4, by: k.by ?? '', date: String(k.at ?? '').slice(0, 10) })}${p.api_base ? '' : ` ${tf('st.vm.key.wait', { provider: p.name })}`}`
        : t('st.vm.key.none');
      const kf = $('vmKeyForm') as HTMLFormElement; kf.hidden = !canKeys; kf.reset();
      $('vmKeyRemove').hidden = k.source !== 'site';
      // Sync now (read only): shows once a key is saved and we know the service's API address.
      const sb = $('vmSyncBtn'); sb.hidden = !p.connected; sb.textContent = tf('st.vm.sync.btn', { provider: p.name });
      $('vmSync').innerHTML = ''; $('vmSyncSum').textContent = ''; $('vmSyncHide').hidden = true;
      const l = $('vmVnoLabel'); l.dataset.i18nVars = JSON.stringify({ provider: p.name }); l.textContent = tf('st.vm.vno', { provider: p.name });
    }
    function paintAll() { paintTabs(); paintProvider(); paint(); }

    function paint() {
      const q = ($('vmSearch') as HTMLInputElement).value.trim().toLowerCase().replace(/^#/, '');
      const ul = $('vmList'); ul.innerHTML = '';
      const mine = rows.filter((v) => v.provider === prov().id);
      // The reminder (Peter, Nov 19 2026: "im going to have to remember to input the renters id"): how many still need an ID date.
      const missing = mine.filter((v) => v.no_id).length;
      if (!missing) onlyNoId = false;
      $('vmNoId').hidden = !missing;
      $('vmNoId').querySelector('span')!.textContent = tf('st.vm.noid.banner', { n: missing, provider: prov().name });
      $('vmNoIdBtn').textContent = onlyNoId ? t('st.vm.noid.all') : t('st.vm.noid.show');
      const list = mine.filter((v) => !onlyNoId || v.no_id).filter((v) => !q || v.vno.toLowerCase().startsWith(q) || v.name.toLowerCase().includes(q) || v.names.some((n: string) => n.toLowerCase().includes(q)));
      for (const v of list) {
        const li = document.createElement('li'); if (v.status === 'closed') li.classList.add('vm-closed');
        const who = document.createElement('div');
        who.innerHTML = '<strong></strong><br /><span class="muted"></span>';
        who.querySelector('strong')!.textContent = `${prov().name} #${v.vno} · ${v.name}${v.status === 'closed' ? ` · ${t('mb.state.closed')}` : ''}`;
        who.querySelector('.muted')!.textContent = [v.phone, v.email, v.names.length ? `${t('st.nm.also')} ${v.names.join(', ')}` : '', v.account ? tf('st.vm.linked', { name: v.account }) : '', v.note].filter(Boolean).join(' · ');
        // The ID on file (Peter, Nov 19 2026): expired means hold their mail; suspended after the grace days.
        const s = v.id_state;
        if (s && s.state !== 'expiring') {
          const badge = document.createElement('span'); badge.className = 'mb-mail mb-mail-rts';
          badge.textContent = s.state === 'suspended' ? tf('st.id.susp', { date: s.expired_on }) : tf('st.id.hold', { date: s.expired_on, susp: s.suspend_on });
          const hm = document.createElement('div'); hm.className = 'mb-holdmail'; hm.innerHTML = '<strong></strong> <span></span>';
          hm.querySelector('strong')!.textContent = t('st.id.holdmail'); hm.querySelector('span')!.textContent = tf('st.id.holdhow.v', { provider: prov().name });
          who.append(' ', badge, hm); li.classList.add('mb-holdmail-row');
        } else if (s?.state === 'expiring') {
          const badge = document.createElement('span'); badge.className = 'mb-exp soon'; badge.textContent = tf('st.id.exp', { date: s.expires_on }); who.append(' ', badge);
        }
        // Type the ID's expiration date right here (from their ID in the service's dashboard); no file needed.
        if (v.no_id || (s && s.state !== 'expiring')) {
          const badge = document.createElement('span'); badge.className = 'mb-exp soon';
          if (v.no_id) { badge.textContent = t('st.vm.noid.badge'); who.append(' ', badge); }
          const f = document.createElement('div'); f.className = 'vm-iddate';
          const date = document.createElement('input'); date.type = 'date'; date.setAttribute('aria-label', t('st.doc.expires'));
          const lab = document.createElement('label'); lab.className = 'check'; const cb = document.createElement('input'); cb.type = 'checkbox';
          lab.append(cb, ' ', t('st.doc.inperson')); lab.hidden = !!v.no_id;
          const save = btn(t('st.vm.noid.save'), '', async () => {
            try {
              const r = await api('/api/mailbox-docs', { action: 'add_date', customer_id: v.doc_key, expires_on: date.value, in_person: cb.checked });
              if (r.reinstated) alert(t('st.doc.reinstated'));
              await load();
            } catch (e: any) { say(e.message, true); }
          });
          f.append(date, save, lab); who.append(f);
        }
        li.append(who, btn(t('st.mb.edit'), 'kraft', () => edit(v)));
        const d = document.createElement('button'); d.type = 'button'; d.className = 'btn small'; d.dataset.mbdocs = v.doc_key; d.textContent = `${t('st.doc.btn')}${v.docs ? ` (${v.docs})` : ''}`; li.append(d);
        // Closing moved into Edit → Danger zone (Peter, Nov 23 2026); a closed one can still be reopened here.
        if (v.status === 'closed') li.append(btn(t('st.vm.reopen'), 'kraft', async () => {
          try { await api('/api/virtual', { action: 'reopen', id: v.id }); await load(); } catch (e: any) { say(e.message, true); }
        }));
        ul.appendChild(li);
      }
      if (!list.length) { const li = document.createElement('li'); li.className = 'muted'; li.textContent = t('st.vm.none'); ul.appendChild(li); }
    }
    async function load() {
      try {
        const j = await api('/api/virtual', { action: 'list' });
        $('vmMain').classList.remove('hidden');
        rows = j.virtual; providers = j.providers; canKeys = !!j.can_manage_keys; role = j.role ?? 'counter';
        paintAll();
      } catch (e: any) { say(e.message, true); }
    }
    ($('vmKeyForm') as HTMLFormElement).addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const input = ($('vmKeyForm') as HTMLFormElement).elements.namedItem('key') as HTMLInputElement;
      try {
        await api('/api/virtual', { action: 'key_save', provider: prov().id, key: input.value });
        input.value = ''; await load(); say(t('st.vm.key.saved'));
      } catch (e: any) { say(e.message, true); }
    });
    $('vmKeyRemove').addEventListener('click', async () => {
      if (!confirm(tf('st.vm.key.removeq', { provider: prov().name }))) return;
      try { await api('/api/virtual', { action: 'key_remove', provider: prov().id }); await load(); say(t('st.vm.key.removed')); }
      catch (e: any) { say(e.message, true); }
    });
    const apiFail = (j: any) => j.result === 'no_path' ? tf('st.vm.danger.nopath', { provider: prov().name })
      : j.result === 'no_renter' ? tf('st.vm.danger.norenter', { provider: prov().name, vno: editing?.vno ?? '' })
      : j.result === 'no_key' ? t('st.vm.key.none') : j.result === 'no_address' ? tf('st.vm.key.wait', { provider: prov().name })
      : j.result === 'rejected' ? tf('st.vm.key.bad', { provider: prov().name }) : j.result === 'not_found' ? t('st.vm.key.path')
      : `${tf('st.vm.key.err', { provider: prov().name })}${j.status ? ` (${j.status})` : ''}${j.message ? ` ${j.message}` : ''}`;
    $('vmKeyTest').addEventListener('click', async () => {
      try {
        const j = await api('/api/virtual', { action: 'key_test', provider: prov().id });
        say(j.ok ? tf('st.vm.key.ok', { provider: prov().name }) : apiFail(j), !j.ok);
      } catch (e: any) { say(e.message, true); }
    });
    // Sync now: their renters next to our list. Each button uses the normal add / update / close / reopen.
    $('vmSyncBtn').addEventListener('click', async () => {
      const box = $('vmSync'); box.innerHTML = ''; $('vmSyncSum').textContent = t('st.vm.sync.wait'); $('vmSyncHide').hidden = true;
      try {
        const j = await api('/api/virtual', { action: 'sync_preview', provider: prov().id });
        if (!j.ok) { $('vmSyncSum').textContent = ''; say(apiFail(j), true); return; }
        $('vmSyncSum').textContent = tf('st.vm.sync.sum', { n: j.renters, ok: j.matched, look: j.rows.length }) + (j.box_check === 'status' ? '' : ` ${tf('st.vm.sync.boxguess', { provider: prov().name })}`);
        $('vmSyncHide').hidden = false;
        // One folding group per kind; the small, act-now groups open, a long "not on our list" folded.
        for (const kind of ['unverified', 'diff', 'inactive', 'reopen', 'new', 'missing', 'pending']) {
          const list = j.rows.filter((r: any) => r.kind === kind);
          if (!list.length) continue;
          const d = document.createElement('details'); d.className = 'vm-sync-group'; d.open = kind === 'pending' ? false : kind !== 'new' ? list.length <= 15 : list.length <= 5;
          const sum = document.createElement('summary'); sum.textContent = tf(`st.vm.sync.g.${kind}`, { n: list.length, provider: prov().name });
          const ul = document.createElement('ul'); ul.className = 'mb-check-out';
          const lis = list.map((r: any) => syncRow(r)); ul.append(...lis);
          d.append(sum);
          if (kind === 'new' && list.length > 1) {
            const p = document.createElement('p'); p.className = 'btnrow';
            const all = btn(tf('st.vm.sync.addall', { n: list.length }), '', async () => {
              if (!confirm(tf('st.vm.sync.addallq', { n: list.length, provider: prov().name }))) return;
              all.disabled = true; let ok = 0, bad = 0;
              for (const li of lis as any[]) {
                if (li.classList.contains('vm-sync-done')) continue;
                try { await api('/api/virtual', li.addBody()); li.markDone(); ok++; }
                catch (e: any) { bad++; li.querySelector('.muted')!.textContent = e.message; li.classList.add('vm-sync-bad'); }
              }
              const k = await api('/api/virtual', { action: 'list' }); rows = k.virtual; paintTabs(); paint();
              say(tf('st.vm.sync.added', { n: ok, bad }), bad > 0);
            });
            p.append(all); box.appendChild(p); // above the group, so it shows even when the group is folded
          }
          if (kind === 'unverified' && list.length > 1) { // the ones imported before this check: close them here in one go
            const p = document.createElement('p'); p.className = 'btnrow';
            const all = btn(tf('st.vm.sync.closeall', { n: list.length }), 'kraft', async () => {
              if (!confirm(tf('st.vm.sync.closeallq', { n: list.length, provider: prov().name }))) return;
              all.disabled = true; let ok = 0;
              for (const li of lis as any[]) {
                if (li.classList.contains('vm-sync-done')) continue;
                try { await api('/api/virtual', li.closeBody()); li.markDone(); ok++; } catch (e: any) { li.querySelector('.muted')!.textContent = e.message; li.classList.add('vm-sync-bad'); }
              }
              const k = await api('/api/virtual', { action: 'list' }); rows = k.virtual; paintTabs(); paint();
              say(tf('st.vm.sync.closed', { n: ok }));
            });
            p.append(all); box.appendChild(p);
          }
          d.append(ul); box.appendChild(d);
        }
      } catch (e: any) { $('vmSyncSum').textContent = ''; say(e.message, true); }
    });
    // Danger zone: close here only, or deactivate / delete at the service after a look-up and the box number typed.
    $('vmCloseOnly').addEventListener('click', async () => {
      const v = editing; if (!v || !confirm(tf('st.vm.closeq', { vno: v.vno, name: v.name, provider: prov().name }))) return;
      try { await api('/api/virtual', { action: 'close', id: v.id }); resetForm(); await load(); } catch (e: any) { say(e.message, true); }
    });
    const dlg = $('vmDangerDlg') as HTMLDialogElement;
    const conf = ($('vmDangerForm') as HTMLFormElement).elements.namedItem('confirm') as HTMLInputElement;
    let pending: { action: string; renter_id: number } | null = null;
    async function danger(kind: 'deactivate' | 'delete') {
      const v = editing; if (!v) return;
      const p = prov();
      say(tf('st.vm.danger.looking', { provider: p.name }));
      try {
        const j = await api('/api/virtual', { action: 'renter_lookup', id: v.id });
        if (!j.ok) { say(apiFail(j), true); return; }
        if (!(kind === 'delete' ? j.can_delete : j.can_deactivate)) { say(tf('st.vm.danger.nopath', { provider: p.name }), true); return; }
        const r = j.renter; say('');
        const vars = { name: v.name, vno: v.vno, provider: p.name, rid: r.id, rname: r.name || '—', boxes: r.mailboxes.join(', '), status: r.status };
        $('vmDangerTitle').textContent = kind === 'delete' ? tf('st.vm.danger.del', { provider: p.name }) : tf('st.vm.danger.deact', { provider: p.name });
        $('vmDangerText').textContent = tf(kind === 'delete' ? 'st.vm.danger.delq' : 'st.vm.danger.deactq', vars);
        $('vmDangerTypeLabel').textContent = tf('st.vm.danger.type', { vno: v.vno });
        conf.value = ''; ($('vmDangerGo') as HTMLButtonElement).disabled = true;
        pending = { action: kind === 'delete' ? 'renter_delete' : 'renter_deactivate', renter_id: r.id };
        dlg.showModal(); conf.focus();
      } catch (e: any) { say(e.message, true); }
    }
    $('vmDeact').addEventListener('click', () => danger('deactivate'));
    $('vmDel').addEventListener('click', () => danger('delete'));
    conf.addEventListener('input', () => { ($('vmDangerGo') as HTMLButtonElement).disabled = conf.value.trim().replace(/^#/, '').toLowerCase() !== String(editing?.vno ?? '').toLowerCase(); });
    $('vmDangerGo').addEventListener('click', async () => {
      if (!pending || !editing) return;
      const go = $('vmDangerGo') as HTMLButtonElement; go.disabled = true;
      try {
        const j = await api('/api/virtual', { ...pending, id: editing.id, confirm: conf.value });
        dlg.close();
        if (!j.ok) { say(apiFail(j), true); return; }
        say(tf('st.vm.danger.done', { provider: prov().name })); resetForm(); await load();
      } catch (e: any) { dlg.close(); say(e.message, true); }
    });
    // Check at Anytime Mailbox: their raw answer about this box, in plain lines Peter can read or send to Claude.
    $('vmCheck').addEventListener('click', async () => {
      const v = editing; if (!v) return;
      const out = $('vmCheckOut'); out.hidden = false; out.textContent = tf('st.vm.danger.looking', { provider: prov().name });
      try {
        const j = await api('/api/virtual', { action: 'renter_check', id: v.id });
        if (!j.ok) { out.textContent = apiFail(j); return; }
        out.textContent = [
          `Box #${j.vno} at ${prov().name}`,
          ...(j.holders.length ? j.holders.map((h: any) => `Renter ${h.id}: status "${h.status}", box assigned ${h.assigned ?? '(no date)'}`) : ['No renter has this box']),
          `Box status: ${j.box_status ?? '(not given)'}${j.box_check === 'status' ? '' : ` (${j.box_check})`}`,
          `Sync says: ${j.sync_says}`,
        ].join('\n');
      } catch (e: any) { out.textContent = e.message; }
    });
    $('vmNoIdBtn').addEventListener('click', () => { onlyNoId = !onlyNoId; paint(); });
    $('vmSyncHide').addEventListener('click', () => { $('vmSync').innerHTML = ''; $('vmSyncSum').textContent = ''; $('vmSyncHide').hidden = true; });
    function syncRow(r: any) {
      const li = document.createElement('li');
      const who = document.createElement('span'); who.innerHTML = '<strong></strong> <span class="muted"></span>';
      const ren = r.renter;
      who.querySelector('strong')!.textContent = `#${r.vno} · ${ren?.name || r.local?.name}`;
      const tag = document.createElement('span'); tag.className = 'mb-mail';
      const fieldName = (f: string) => t(f === 'name' ? 'st.c.th.name' : f === 'email' ? 'st.vm.email' : 'st.vm.phone');
      const done = (b: HTMLButtonElement) => { b.disabled = true; li.classList.add('vm-sync-done'); };
      const save = async (b: HTMLButtonElement, body: Record<string, unknown>) => {
        try { await api('/api/virtual', body); done(b); const j = await api('/api/virtual', { action: 'list' }); rows = j.virtual; paintTabs(); paint(); }
        catch (e: any) { say(e.message, true); }
      };
      const fromRenter = (l?: any) => ({ provider: prov().id, vno: r.vno, name: ren.name || l?.name, email: ren.email ?? l?.email, phone: ren.phone ?? l?.phone,
        names: l ? l.names : (ren.company ? [ren.company] : []), customer_id: l ? rows.find((x) => x.id === l.id)?.customer_id ?? null : null, note: l ? rows.find((x) => x.id === l.id)?.note ?? null : null });
      if (r.kind === 'new') {
        tag.textContent = t('st.vm.sync.new'); who.querySelector('.muted')!.textContent = [ren.email, ren.phone, ren.company].filter(Boolean).join(' · ');
        const b = btn(t('st.vm.sync.add'), '', () => save(b, { action: 'add', ...fromRenter() })); li.append(who, tag, b);
        Object.assign(li, { addBody: () => ({ action: 'add', ...fromRenter() }), markDone: () => done(b) });
      } else if (r.kind === 'diff') {
        tag.textContent = tf('st.vm.sync.diff', { fields: r.fields.map(fieldName).join(', ') });
        who.querySelector('.muted')!.textContent = r.fields.map((f: string) => `${fieldName(f)}: ${r.local[f] ?? '—'} → ${ren[f] ?? '—'}`).join(' · ');
        const b = btn(t('st.vm.sync.use'), '', () => save(b, { action: 'update', id: r.local.id, ...fromRenter(r.local) })); li.append(who, tag, b);
      } else if (r.kind === 'inactive') {
        tag.textContent = tf('st.vm.sync.inactive', { provider: prov().name }); tag.classList.add('mb-mail-rts');
        const b = btn(t('st.vm.close'), 'kraft', () => save(b, { action: 'close', id: r.local.id })); li.append(who, tag, b);
      } else if (r.kind === 'unverified') {
        tag.textContent = tf('st.vm.sync.unver', { provider: prov().name }); tag.classList.add('mb-mail-rts');
        const b = btn(t('st.vm.danger.closeonly'), 'kraft', () => save(b, { action: 'close', id: r.local.id })); li.append(who, tag, b);
        Object.assign(li, { closeBody: () => ({ action: 'close', id: r.local.id }), markDone: () => done(b) });
      } else if (r.kind === 'pending') {
        tag.textContent = tf('st.vm.sync.pend', { provider: prov().name }); who.querySelector('.muted')!.textContent = [ren.email, ren.phone].filter(Boolean).join(' · ');
        li.append(who, tag);
      } else if (r.kind === 'reopen') {
        tag.textContent = tf('st.vm.sync.reopen', { provider: prov().name });
        const b = btn(t('st.vm.reopen'), 'kraft', () => save(b, { action: 'reopen', id: r.local.id })); li.append(who, tag, b);
      } else {
        tag.textContent = tf('st.vm.sync.missing', { provider: prov().name }); tag.classList.add('mb-mail-rts'); li.append(who, tag);
      }
      return li;
    }
    function setAccount(id: string | null, name: string | null) {
      field('customer_id').value = id ?? '';
      $('vmAccount').textContent = name ?? t('st.vm.noacct');
      $('vmUnlink').hidden = !id; $('vmFound').innerHTML = '';
    }
    let editing: any = null;
    function resetForm() {
      form.reset(); field('id').value = ''; setAccount(null, null); editing = null; $('vmDanger').hidden = true;
      $('vmSave').textContent = t('st.vm.save'); $('vmCancel').hidden = true;
    }
    function edit(v: any) {
      field('id').value = String(v.id); field('vno').value = v.vno; field('name').value = v.name; field('email').value = v.email ?? '';
      field('phone').value = v.phone ?? ''; (form.elements.namedItem('names') as HTMLTextAreaElement).value = v.names.join('\n'); field('note').value = v.note ?? '';
      setAccount(v.customer_id, v.account);
      $('vmSave').textContent = t('st.vm.update'); $('vmCancel').hidden = false;
      ($('vmAddBox') as HTMLDetailsElement).open = true;
      editing = v;
      $('vmCheckBox').hidden = !prov().connected; $('vmCheckOut').hidden = true;
      $('vmCheck').textContent = tf('st.vm.check', { provider: prov().name, vno: v.vno });
      const p = prov(); const mgr = role === 'manager' || role === 'owner';
      $('vmDanger').hidden = !mgr || v.status !== 'active';
      $('vmDangerLead').textContent = tf('st.vm.danger.lead', { provider: p.name });
      $('vmDeact').textContent = tf('st.vm.danger.deact', { provider: p.name });
      $('vmDel').textContent = tf('st.vm.danger.del', { provider: p.name }); $('vmDel').hidden = role !== 'owner';
      form.scrollIntoView({ behavior: 'smooth' });
    }
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const id = field('id').value;
      const body = { action: id ? 'update' : 'add', id: id ? Number(id) : undefined, provider: prov().id, vno: field('vno').value, name: field('name').value, email: field('email').value, phone: field('phone').value,
        names: (form.elements.namedItem('names') as HTMLTextAreaElement).value.split('\n').map((s) => s.trim()).filter(Boolean), note: field('note').value, customer_id: field('customer_id').value || null };
      try { const r = await api('/api/virtual', body); say(tf(id ? 'st.vm.updated' : 'st.vm.added', { vno: r.virtual.vno, name: r.virtual.name })); resetForm(); await load(); }
      catch (e: any) { say(e.message, true); }
    });
    $('vmCancel').addEventListener('click', resetForm);
    $('vmUnlink').addEventListener('click', () => setAccount(null, null));
    $('vmFind').addEventListener('click', async () => {
      try {
        const j = await api('/api/mailbox', { action: 'find', q: ($('vmFindQ') as HTMLInputElement).value });
        const ul = $('vmFound'); ul.innerHTML = '';
        for (const c of j.customers) {
          const li = document.createElement('li');
          li.append(btn(t('st.mb.pick'), 'kraft', () => setAccount(c.id, c.name)), ` ${c.name} · ${[c.phone, c.email].filter(Boolean).join(' · ')}`);
          ul.appendChild(li);
        }
        if (!j.customers.length) { const li = document.createElement('li'); li.className = 'muted'; li.textContent = t('st.mb.nofound'); ul.appendChild(li); }
      } catch (e: any) { say(e.message, true); }
    });
    $('vmSearch').addEventListener('input', paint);
    $('load').addEventListener('click', load);
    $('pin').addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') load(); });
    window.addEventListener('mbdocs:changed', () => { if (!$('vmMain').classList.contains('hidden')) load(); });
  </script>
</Base>
