---
export const prerender = false;
import Base from '../../layouts/Base.astro';

// Staff page: mailboxes on the website (Peter, Nov 15 2026). Reservations made online wait here until the customer
// comes in with two IDs and the PS Form 1583; then staff assign a box number, and the holder sees it on their
// account. Boxes in use show their paid-through date and status; Edit opens a pop-up to add or take off time, set
// the date, send a reminder or close the box (Peter, Nov 17 2026). Send due reminders texts and emails everyone whose
// box is due (each reminder goes out once); the live site also does it every morning (src/worker.ts). The counter's register is still where
// the IDs, the 1583 and the payments are kept.
---
<Base title="Counter · Mailboxes">
  <section class="hero">
    <h1 data-i18n="st.mb.h1">Mailboxes</h1>
    <p class="staff-nav"><span data-i18n="st.staff">Staff:</span> <a href="/counter/queue" data-i18n="st.nav.queue">Queue</a> · <a href="/counter/batch" data-i18n="st.nav.batch">Batch</a> · <a href="/counter/fulfillment" data-i18n="st.nav.fulfillment">Fulfillment</a> · <a href="/counter/pickups" data-i18n="st.nav.pickups">Pickups</a> · <a href="/counter/customers" data-i18n="st.nav.customers">Customers</a> · <a href="/counter/accounts" data-i18n="st.nav.accounts">Accounts</a> · <a href="/counter/dropoff" data-i18n="st.nav.dropoffs">Drop-offs</a> · <a href="/counter/scan" data-i18n="st.nav.scan">Scan a QR</a> · <a href="/counter/exceptions" data-i18n="st.nav.exceptions">Exceptions</a> · <a href="/counter/claims" data-i18n="st.nav.claims">Claims</a> · <a href="/counter/reports" data-i18n="st.nav.reports">Reports</a> · <a href="/counter/close" data-i18n="st.nav.close">End of day</a> · <a href="/counter/invoices" data-i18n="st.nav.invoices">Invoices</a> · <a href="/counter/rules" data-i18n="st.nav.prices">Prices</a> · <a href="/counter/staff" data-i18n="st.nav.staff">Staff</a> · <a href="/counter/settings" data-i18n="st.nav.settings">Settings</a> · <a href="/counter/mailboxes" data-i18n="st.nav.mailboxes">Mailboxes</a> · <a href="/counter/export" data-i18n="st.nav.export">Export</a></p>
    <p class="lead" data-i18n="st.mb.lead">Online reservations, the boxes assigned to website accounts, renewals and reminders. IDs, the 1583 and payments still go in the register.</p>
  </section>

  <div class="card">
    <p class="btnrow">
      <label><span data-i18n="st.pin">Staff PIN</span> <input id="pin" type="password" inputmode="numeric" autocomplete="off" /></label>
      <button class="btn" id="load" data-i18n="st.show">Show</button>
    </p>
    <p id="msg" role="alert"></p>
  </div>

  <div id="mbMain" class="hidden">
    <div class="card mb-check">
      <h3 data-i18n="st.mb.check.h">Mail check</h3>
      <p class="muted" data-i18n="st.mb.check.p">Got mail for a box? Type the box number or the name on the mail to see whether it goes in the box, gets held, or goes back to the sender.</p>
      <form id="checkForm" class="btnrow"><input id="checkQ" data-i18n-ph="st.mb.check.ph" placeholder="Box # or name" autocomplete="off" /> <button class="btn small" type="submit" data-i18n="st.mb.check">Check</button></form>
      <ul id="checkOut" class="mb-check-out"></ul>
    </div>

    <p id="rtsAlert" class="mb-rts-alert" hidden></p>

    <div class="card">
      <h3 data-i18n="st.mb.free">Free boxes</h3>
      <p id="free"></p>
      <p class="btnrow"><button class="btn" id="sendDue" data-i18n="st.mb.senddue">Send due reminders</button> <span class="muted" data-i18n="st.mb.senddue.p2">They also go out by themselves every morning on the live site: 2 months, 1 month and 1 week before, and the day after a box expires. Each reminder goes out once.</span></p>
      <ul id="sentList"></ul>
    </div>

    <div class="card">
      <h3 data-i18n="st.mb.res">Reservations waiting</h3>
      <p class="muted" data-i18n="st.mb.res.p">When they come in with two IDs and the 1583, type the box number and press Assign.</p>
      <table class="list" id="resTable"><thead><tr><th data-i18n="st.mb.code">Code</th><th data-i18n="st.c.th.name">Name</th><th data-i18n="st.mb.contact">Contact</th><th data-i18n="st.mb.size">Size</th><th data-i18n="st.mb.term">Term</th><th data-i18n="st.mb.box">Box #</th><th></th></tr></thead><tbody></tbody></table>
      <p class="muted" id="noRes" hidden data-i18n="st.mb.nores">No reservations waiting.</p>
    </div>

    <div class="card">
      <h3 data-i18n="st.mb.boxes">Boxes on the website</h3>
      <table class="list" id="boxTable"><thead><tr><th data-i18n="st.mb.box">Box #</th><th data-i18n="st.mb.holder">Holder</th><th data-i18n="st.mb.contact">Contact</th><th data-i18n="st.mb.size">Size</th><th data-i18n="st.mb.paidthru">Paid through</th><th data-i18n="st.mb.status">Status</th><th></th></tr></thead><tbody></tbody></table>
      <p class="muted" id="noBoxes" hidden data-i18n="st.mb.noboxes">No boxes assigned on the website yet.</p>
    </div>

    <div class="card">
      <h3 data-i18n="st.mb.ended.h">Expired and closed boxes</h3>
      <p class="muted" id="endedP"></p>
      <table class="list" id="endedTable"><thead><tr><th data-i18n="st.mb.box">Box #</th><th data-i18n="st.mb.holder">Holder</th><th data-i18n="st.mb.contact">Contact</th><th data-i18n="st.mb.endedon">Ended</th><th data-i18n="st.mb.mail">Mail</th><th></th></tr></thead><tbody></tbody></table>
      <p class="muted" id="noEnded" hidden data-i18n="st.mb.noended">No expired or closed boxes.</p>
    </div>

    <div class="card">
      <h3 data-i18n="st.mb.assign.h">Assign a box to an account</h3>
      <p class="muted" data-i18n="st.mb.assign.p">For a customer who signed up at the counter: find their website account, then give them their box.</p>
      <p class="btnrow"><input id="findQ" data-i18n-ph="st.mb.find.ph" placeholder="Name, email or phone" /> <button class="btn small" id="findBtn" data-i18n="st.mb.find">Find</button></p>
      <ul id="found" class="mb-found"></ul>
      <form id="assignForm" class="hidden mb-assign">
        <p><span data-i18n="st.mb.for">For:</span> <strong id="assignWho"></strong></p>
        <label><span data-i18n="st.mb.box">Box #</span> <input name="box_no" inputmode="numeric" required /></label>
        <label><span data-i18n="st.mb.term">Term</span> <select name="term"><option value="6" data-i18n="st.mb.six">6 months</option><option value="12" data-i18n="st.mb.year">1 year</option></select></label>
        <label><span data-i18n="st.mb.start">Start date</span> <input name="start_date" type="date" /></label>
        <button class="btn small" type="submit" data-i18n="st.mb.assign">Assign</button>
      </form>
    </div>
  </div>

  <dialog id="mbEdit" class="hz-dialog mb-edit" aria-labelledby="mbEditH">
    <h2 id="mbEditH"></h2>
    <p id="mbEditWho" class="muted"></p>
    <p><span data-i18n="st.mb.paidthru">Paid through</span>: <strong id="mbEditDate"></strong> <span id="mbEditState"></span></p>
    <p id="mbEditMail"></p>
    <p class="err" id="mbEditErr" hidden></p>
    <h3 data-i18n="st.mb.addtime">Add time</h3>
    <p class="btnrow"><button type="button" class="btn small" data-months="6" data-i18n="st.mb.renew6">+6 months</button> <button type="button" class="btn small" data-months="12" data-i18n="st.mb.renew12">+1 year</button></p>
    <h3 data-i18n="st.mb.taketime">Take time off (to undo a mistake)</h3>
    <p class="btnrow"><button type="button" class="btn small kraft" data-months="-6" data-i18n="st.mb.minus6">−6 months</button> <button type="button" class="btn small kraft" data-months="-12" data-i18n="st.mb.minus12">−1 year</button></p>
    <h3 data-i18n="st.mb.setdate">Or set the paid-through date</h3>
    <p class="btnrow"><input type="date" id="mbEditNew" /> <button type="button" class="btn small kraft" id="mbEditSave" data-i18n="st.mb.save">Save</button></p>
    <hr />
    <p class="btnrow mb-edit-foot">
      <button type="button" class="btn small kraft" id="mbEditRemind" data-i18n="st.mb.remindnow">Send a reminder now</button>
      <button type="button" class="linkish mb-danger" id="mbEditClose" data-i18n="st.mb.closebox">Close this box</button>
      <button type="button" class="btn small" id="mbEditDone" data-i18n="st.mb.done">Done</button>
    </p>
  </dialog>

  <script>
    import { t, tf } from '../../i18n';
    const $ = (id: string) => document.getElementById(id)!;
    const pin = () => ($('pin') as HTMLInputElement).value;
    const msg = $('msg');
    const say = (text: string, err = false) => { msg.className = err ? 'err' : 'ok-msg'; msg.textContent = text; };
    async function api(extra: Record<string, unknown>) {
      const res = await fetch('/api/mailbox', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pin: pin(), ...extra }) });
      const j = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(j.error ?? 'Try again');
      return j;
    }
    const cell = (tr: HTMLElement, text: string) => { const td = document.createElement('td'); td.textContent = text; tr.appendChild(td); return td; };
    const btn = (label: string, cls: string, fn: () => void) => { const b = document.createElement('button'); b.type = 'button'; b.className = `btn small ${cls}`; b.textContent = label; b.addEventListener('click', fn); return b; };
    const sizeName = (id: string) => t(`mb.size.${id}`);
    const termName = (n: number) => (n === 12 ? t('st.mb.year') : t('st.mb.six'));
    const stageName = (st: string) => (st === 'over' ? t('st.mb.lapsed') : ['60', '30', '7'].includes(st) ? t(`st.mb.stage.${st}`) : tf('st.mb.daysleft', { n: st }));
    // What to do with mail for a box today: in the box, hold until a date, or return to sender.
    const mailText = (m: any) => (m.do === 'box' ? t('st.mb.do.box') : m.do === 'hold' ? tf('st.mb.do.hold', { date: m.until }) : tf('st.mb.do.rts', { date: m.since }));
    const mailBadge = (m: any) => { const b = document.createElement('span'); b.className = `mb-mail mb-mail-${m.do}`; b.textContent = mailText(m); return b; };
    const contact = (c: any) => [c.phone, c.email].filter(Boolean).join(' · ');

    async function load() {
      try {
        const j = await api({ action: 'list' });
        $('mbMain').classList.remove('hidden');
        $('free').textContent = j.sizes.map((s: any) => `${sizeName(s.id)} (#${s.from}–${s.to}): ${s.free}`).join('   ·   ');
        const rb = $('resTable').querySelector('tbody')!; rb.innerHTML = '';
        $('noRes').hidden = j.reservations.length > 0;
        for (const r of j.reservations) {
          const tr = document.createElement('tr');
          cell(tr, r.code); cell(tr, r.customer.name); cell(tr, contact(r.customer)); cell(tr, sizeName(r.size)); cell(tr, `${termName(r.term)} · $${r.price}`);
          const input = document.createElement('input'); input.inputMode = 'numeric'; input.size = 6; input.placeholder = String(j.sizes.find((s: any) => s.id === r.size)?.from ?? '');
          cell(tr, '').appendChild(input);
          cell(tr, '').appendChild(btn(t('st.mb.assign'), '', async () => {
            try { await api({ action: 'assign', customer_id: r.customer_id, box_no: Number(input.value), term: r.term, reservation_code: r.code }); say(tf('st.mb.assigned', { box: input.value, name: r.customer.name })); load(); }
            catch (e: any) { say(e.message, true); }
          }));
          rb.appendChild(tr);
        }
        const bb = $('boxTable').querySelector('tbody')!; bb.innerHTML = '';
        $('noBoxes').hidden = j.boxes.length > 0;
        for (const x of j.boxes) {
          const tr = document.createElement('tr');
          cell(tr, `#${x.box_no}`); cell(tr, x.customer.name); cell(tr, contact(x.customer)); cell(tr, sizeName(x.size)); cell(tr, x.paid_through);
          const st = cell(tr, ''); const badge = document.createElement('span'); badge.className = `acct-status mb-${x.state}`; badge.textContent = t(`mb.state.${x.state}`); st.appendChild(badge);
          cell(tr, '').appendChild(btn(t('st.mb.edit'), 'kraft', () => openEdit(x)));
          bb.appendChild(tr);
        }
        // Expired and closed: what to do with their mail, return-to-sender first.
        $('endedP').textContent = tf('st.mb.ended.p', { hold: j.hold_months, keep: j.keep_months });
        const eb = $('endedTable').querySelector('tbody')!; eb.innerHTML = '';
        $('noEnded').hidden = j.ended.length > 0;
        for (const x of j.ended) {
          const tr = document.createElement('tr');
          cell(tr, `#${x.box_no}`); cell(tr, x.customer.name); cell(tr, contact(x.customer));
          cell(tr, `${x.mail.ended} · ${t(x.status === 'closed' ? 'mb.state.closed' : 'mb.state.overdue')}`);
          cell(tr, '').appendChild(mailBadge(x.mail));
          const act = cell(tr, '');
          if (x.status === 'active') act.appendChild(btn(t('st.mb.edit'), 'kraft', () => openEdit(x)));
          eb.appendChild(tr);
        }
        const rts = j.ended.filter((x: any) => x.mail.do === 'rts');
        $('rtsAlert').hidden = !rts.length;
        $('rtsAlert').textContent = rts.length ? `${tf('st.mb.rtsn', { n: rts.length })} ${rts.map((x: any) => `#${x.box_no} ${x.customer.name}`).join(' · ')}` : '';
        boxes = [...j.boxes, ...j.ended.filter((x: any) => x.status === 'active')];
        if (editing) { const fresh = boxes.find((x: any) => x.id === editing!.id); if (fresh) paintEdit(fresh); else dlg.close(); }
      } catch (e: any) { say(e.message, true); }
    }

    // The Edit pop-up for one box: add or take off time, set the date, remind, close.
    const dlg = $('mbEdit') as HTMLDialogElement;
    const editErr = $('mbEditErr');
    let boxes: any[] = [];
    let editing: any = null;
    function paintEdit(x: any) {
      editing = x;
      $('mbEditH').textContent = `${t('st.mb.box').replace(/\s*#$/, '')} #${x.box_no} · ${sizeName(x.size)}`;
      $('mbEditWho').textContent = `${x.customer.name} · ${contact(x.customer)}`;
      $('mbEditDate').textContent = x.paid_through;
      const st = $('mbEditState'); st.className = `acct-status mb-${x.state}`; st.textContent = t(`mb.state.${x.state}`);
      ($('mbEditNew') as HTMLInputElement).value = x.paid_through;
      const mm = $('mbEditMail'); mm.innerHTML = ''; if (x.mail && x.mail.do !== 'box') mm.appendChild(mailBadge(x.mail));
    }
    function openEdit(x: any) { editErr.hidden = true; paintEdit(x); dlg.showModal(); }
    async function editDo(body: Record<string, unknown>, done: (r: any) => string) {
      editErr.hidden = true;
      try { const r = await api({ id: editing.id, ...body }); say(done(r)); await load(); }
      catch (e: any) { editErr.textContent = e.message; editErr.hidden = false; }
    }
    dlg.querySelectorAll<HTMLButtonElement>('[data-months]').forEach((b) => b.addEventListener('click', () =>
      editDo({ action: 'adjust', months: Number(b.dataset.months) }, (r) => tf('st.mb.dated', { box: editing.box_no, date: r.paid_through }))));
    $('mbEditSave').addEventListener('click', () =>
      editDo({ action: 'set_paid_through', date: ($('mbEditNew') as HTMLInputElement).value }, (r) => tf('st.mb.dated', { box: editing.box_no, date: r.paid_through })));
    $('mbEditRemind').addEventListener('click', () =>
      editDo({ action: 'remind' }, (r) => tf('st.mb.reminded', { box: editing.box_no, how: [r.sms ? t('st.mb.text') : '', r.email ? t('st.mb.email') : ''].filter(Boolean).join(' + ') || '—' })));
    $('mbEditClose').addEventListener('click', async () => {
      if (!confirm(tf('st.mb.closeq', { box: editing.box_no }))) return;
      await editDo({ action: 'close' }, () => '');
      if (!boxes.some((x) => x.id === editing?.id)) { editing = null; dlg.close(); }
    });
    $('mbEditDone').addEventListener('click', () => { editing = null; dlg.close(); });
    dlg.addEventListener('close', () => { editing = null; });
    $('load').addEventListener('click', load);
    $('pin').addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') load(); });

    // Mail check: a box number or a name; current holder first, then past holders of that box.
    $('checkForm').addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const ul = $('checkOut'); ul.innerHTML = '';
      try {
        const j = await api({ action: 'search', q: ($('checkQ') as HTMLInputElement).value });
        if (!j.boxes.length) { const li = document.createElement('li'); li.className = 'muted'; li.textContent = t('st.mb.nomatch'); ul.appendChild(li); return; }
        for (const x of j.boxes) {
          const li = document.createElement('li');
          const who = document.createElement('div');
          who.innerHTML = '<strong></strong> <span class="muted"></span>';
          who.querySelector('strong')!.textContent = `#${x.box_no} · ${x.customer.name}`;
          who.querySelector('.muted')!.textContent = `${t(`mb.state.${x.state}`)} · ${t('st.mb.paidthru')} ${x.paid_through}`;
          li.append(who, mailBadge(x.mail));
          if (x.status === 'active') li.append(' ', btn(t('st.mb.edit'), 'kraft', () => openEdit(x)));
          ul.appendChild(li);
        }
      } catch (e: any) { say(e.message, true); }
    });

    $('sendDue').addEventListener('click', async () => {
      try {
        const j = await api({ action: 'send_due' });
        const ul = $('sentList'); ul.innerHTML = '';
        if (!j.sent.length) { say(t('st.mb.nonedue')); return; }
        say(tf('st.mb.sentn', { n: j.sent.length }));
        for (const s of j.sent) { const li = document.createElement('li'); li.textContent = `#${s.box_no} ${s.name} · ${stageName(s.key.split(':')[1])}`; ul.appendChild(li); }
        load();
      } catch (e: any) { say(e.message, true); }
    });

    let chosen: { id: string; name: string } | null = null;
    $('findBtn').addEventListener('click', async () => {
      try {
        const j = await api({ action: 'find', q: ($('findQ') as HTMLInputElement).value });
        const ul = $('found'); ul.innerHTML = '';
        if (!j.customers.length) { const li = document.createElement('li'); li.className = 'muted'; li.textContent = t('st.mb.nofound'); ul.appendChild(li); }
        for (const c of j.customers) {
          const li = document.createElement('li');
          li.append(btn(t('st.mb.pick'), 'kraft', () => { chosen = { id: c.id, name: c.name }; $('assignWho').textContent = `${c.name} · ${contact(c)}`; $('assignForm').classList.remove('hidden'); }), ` ${c.name} · ${contact(c)}`);
          ul.appendChild(li);
        }
      } catch (e: any) { say(e.message, true); }
    });
    $('assignForm').addEventListener('submit', async (ev) => {
      ev.preventDefault(); if (!chosen) return;
      const f = ev.target as HTMLFormElement; const d = Object.fromEntries(new FormData(f).entries()) as Record<string, string>;
      try { await api({ action: 'assign', customer_id: chosen.id, box_no: Number(d.box_no), term: Number(d.term), start_date: d.start_date || undefined }); say(tf('st.mb.assigned', { box: d.box_no, name: chosen.name })); f.reset(); f.classList.add('hidden'); $('found').innerHTML = ''; load(); }
      catch (e: any) { say(e.message, true); }
    });
  </script>
</Base>
